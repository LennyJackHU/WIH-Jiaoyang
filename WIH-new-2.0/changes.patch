+</main>
+
+<!-- ================= 屏三 · 社群诗集墙 ================= -->
+<section class="community screen is-hidden" id="screen-community">
+  <button class="back-link" data-go="home">← 返回首页</button>
+  <header class="community-head">
+    <h1>The Poetry Wall</h1>
+    <p>诗 集 墙 · 句 子 与 故 事 的 集 市</p>
+    <button class="btn-publish" id="btn-new-post">＋ 发布我的作品</button>
+  </header>
+  <div class="feed" id="feed"></div>
+</section>
+
+<!-- ================= 屏四 · 发布 ================= -->
+<section class="publish screen is-hidden" id="screen-publish">
+  <button class="back-link" data-go="community">← 返回诗集墙</button>
+  <h1>Publish a Piece</h1>
+  <p class="pub-sub">发 布 · 把 句 子 留 在 墙 上</p>
+  <div class="pub-card">
+    <div class="pub-ref" id="pub-ref"></div>
+    <div class="pub-types" role="group" aria-label="作品类型">
+      <button class="pub-type active" data-type="poem">拼贴诗</button>
+      <button class="pub-type" data-type="story">故事续写</button>
+    </div>
+    <div class="pub-field">
+      <label for="pub-name">署名</label>
+      <input type="text" id="pub-name" placeholder="匿名诗人" maxlength="12">
+    </div>
+    <div class="pub-field">
+      <label for="pub-content" id="pub-content-label">你的拼贴诗</label>
+      <textarea id="pub-content" placeholder="he counts stars&#10;she paints with light&#10;soon&#10;we lit the dark"></textarea>
+    </div>
+    <div class="pub-actions">
+      <button class="btn-cancel" id="btn-cancel-pub">取消</button>
+      <button class="btn-submit" id="btn-submit-pub">发布上墙</button>
+    </div>
+  </div>
+</section>
+
+<script>
+/* ============================================================
+ * Words in Hand · App 式翻页流程
+ * #/home → #/studio（拼贴台）→ #/muse（评价/故事/语言学习）
+ *        → #/community（诗集墙）→ #/publish（发帖）
+ * 数据流：
+ *   ESP32-S3 固件 →（Web Serial）→ placeWord(word)
+ *   句子 →（server.py 代理大模型 API）→ 评价 / 故事 / 语言学习
+ *   帖子 → localStorage（社群墙本地存储）
+ * ============================================================ */
+
+// ---------- 页面路由 ----------
+const PAGES = {
+  home: 'screen-home',
+  studio: 'screen-studio',
+  muse: 'screen-muse',
+  community: 'screen-community',
+  publish: 'screen-publish'
+};
+let currentPage = 'home';
+
+function pageFromHash() {
+  const m = location.hash.match(/^#\/([a-z]+)/);
+  return (m && PAGES[m[1]]) ? m[1] : 'home';
+}
+
+function go(page) {
+  if (location.hash === '#/' + page) renderPage(page);
+  else location.hash = '#/' + page;
+}
+
+function renderPage(page) {
+  currentPage = page;
+  document.querySelectorAll('.screen').forEach(s => s.classList.add('is-hidden'));
+  document.getElementById(PAGES[page]).classList.remove('is-hidden');
+  window.scrollTo(0, 0);
+  if (page === 'muse') renderMuseSentence();
+  if (page === 'community') renderFeed();
+}
+
+window.addEventListener('hashchange', () => renderPage(pageFromHash()));
+document.querySelectorAll('.back-link').forEach(b =>
+  b.addEventListener('click', () => go(b.dataset.go)));
+
+// ---------- 设备连接状态 ----------
+let deviceConnected = false;
+function renderDevice() {
+  document.querySelectorAll('.device-chip').forEach(chip => {
+    chip.classList.toggle('connected', deviceConnected);
+    chip.querySelector('.chip-text').textContent =
+      deviceConnected ? '词块已连接 · ESP32-S3' : (window.wihStatusText || '词块未连接');
+  });
+  document.getElementById('chip-toggle').textContent =
+    deviceConnected ? '断开' : '连接设备';
+}
+
+document.getElementById('btn-start').addEventListener('click', () => go('studio'));
+document.getElementById('btn-community').addEventListener('click', () => go('community'));
+document.getElementById('btn-finish').addEventListener('click', () => {
+  if (!sentence.length) {
+    document.getElementById('next-hint').textContent = '先放上一个词块，再去缪斯那里吧。';
+    return;
+  }
+  document.getElementById('next-hint').textContent = '拼好后进入下一页，让缪斯读一读、酿一段故事，或讲讲语法。';
+  go('muse');
+});
+
+// ---------- 词库与拼贴 ----------
+const WORD_POOL = ["he", "she", "we", "they", "you", "i", "it", "the", "a", "an", "this", "that", "these", "those", "my", "your", "our", "their", "is", "are", "was", "were", "be", "been", "will", "would", "can", "could", "should", "may", "might", "must", "do", "does", "did", "have", "has", "had", "and", "or", "but", "so", "if", "while", "when", "where", "why", "how", "with", "without", "within", "into", "through", "across", "above", "below", "beside", "between", "beneath", "beyond", "near", "far", "from", "to", "of", "for", "in", "on", "at", "by", "as", "not", "never", "always", "still", "again", "here", "there", "now", "then", "soon", "once", "every", "each", "all", "some", "many", "little", "more", "less", "one", "two", "moon", "stars", "sun", "sky", "cloud", "rain", "snow", "wind", "sea", "river", "ocean", "lake", "forest", "tree", "leaf", "flower", "stone", "sand", "field", "garden", "mountain", "path", "road", "window", "door", "room", "house", "home", "paper", "book", "letter", "story", "poem", "word", "voice", "song", "light", "shadow", "silence", "dream", "memory", "time", "morning", "evening", "night", "dawn", "dusk", "winter", "spring", "summer", "autumn", "hand", "heart", "eye", "smile", "bird", "wing", "seed", "root", "water", "fire", "earth", "air", "hold", "holds", "carry", "carries", "bring", "brings", "find", "finds", "make", "makes", "paint", "paints", "count", "counts", "sleep", "sleeps", "wake", "wakes", "sing", "sings", "whisper", "whispers", "bloom", "blooms", "drift", "drifts", "wander", "wanders", "flow", "flows", "fall", "falls", "rise", "rises", "shine", "shines", "glow", "glows", "dance", "dances", "wait", "waits", "listen", "listens", "remember", "remembers", "forget", "forgets", "open", "opens", "close", "closes", "touch", "touches", "meet", "meets", "love", "loves", "leave", "leaves", "return", "returns", "write", "writes", "read", "reads", "walk", "walks", "run", "runs", "stay", "stays", "grow", "grows", "soft", "softly", "slow", "slowly", "quiet", "quietly", "gentle", "gently", "bright", "dark", "warm", "cold", "blue", "green", "gold", "silver", "small", "deep", "wide", "empty", "full", "distant", "hidden", "wild", "tender", "fragile", "endless", "together", "apart", "away", "inside", "outside", "tonight", "tomorrow", "yesterday"];
+
+const bankEl  = document.getElementById('bank-tiles');
+const lineEl  = document.getElementById('sentence-line');
+const museOut = document.getElementById('muse-out');
+const sentence = [];   // { word, el, editor? }
+
+function refreshWordBank() {
+  const used = new Set(sentence.map(entry => entry.word));
+  let pool = WORD_POOL.filter(word => !used.has(word));
+  if (pool.length < 30) pool = [...WORD_POOL];
+  for (let i = pool.length - 1; i > 0; i--) {
+    const j = Math.floor(Math.random() * (i + 1));
+    [pool[i], pool[j]] = [pool[j], pool[i]];
+  }
+  let next = pool.slice(0, 30);
+  const previous = [...bankEl.children].map(tile => tile.textContent);
+  // Even a deterministic random source must not leave the same visible bank.
+  if (next.every((word, index) => word === previous[index])) {
+    next = pool.slice(1, 31);
+  }
+  bankEl.replaceChildren();
+  next.forEach((word, index) => {
+    const tile = document.createElement('button');
+    tile.type = 'button'; tile.className = 'tile'; tile.dataset.c = index % 4;
+    tile.textContent = word;
+    tile.setAttribute('aria-label', '放上词块 ' + word);
+    tile.classList.toggle('used', used.has(word));
+    tile.disabled = used.has(word);
+    tile.addEventListener('click', () => {
+      placeWord(word, index % 4);
+      tile.classList.add('used'); tile.disabled = true;
+    });
+    bankEl.appendChild(tile);
+  });
+}
+document.getElementById('btn-refresh-bank').addEventListener('click', refreshWordBank);
+refreshWordBank();
+
+function placeWord(word, colorIdx) {
+  const t = document.createElement('button');
+  t.type = 'button';
+  t.className = 'tile in-line';
+  t.dataset.c = colorIdx ?? Math.floor(Math.random() * 4);
+  t.textContent = word;
+  t.title = '点击修改词形';
+  const entry = { word, el: t };
+  t.addEventListener('click', () => editWord(entry));
+  sentence.push(entry);
+  lineEl.appendChild(t);
+  invalidateMuse();
+}
+
+// 点击句中词块 → 原地变成输入框，可改词形（三单、过去式等）；清空保存即删除。
+function editWord(entry) {
+  if (entry.editor) return;
+  const old = entry.word;
+  const input = document.createElement('input');
+  input.type = 'text';
+  input.className = 'tile-edit';
+  input.value = old;
+  input.maxLength = 24;
+  input.setAttribute('aria-label', '修改词块 ' + old);
+  entry.el.replaceWith(input);
+  entry.editor = input;
+  input.focus();
+  input.select();
+
+  let closed = false;
+  const finish = save => {
+    if (closed) return;
+    closed = true;
+    const next = input.value.trim().toLowerCase().replace(/[^a-z'\-]/g, '');
+    entry.editor = null;
+    input.replaceWith(entry.el);
+    if (save && !next) {
+      removeWord(sentence.indexOf(entry));
+      return;
+    }
+    if (save && next !== old) {
+      releaseBankTile(old);
+      entry.word = next;
+      entry.el.textContent = next;
+      entry.el.title = '点击修改词形';
+      markBankTile(next);
+      invalidateMuse();
+    }
+  };
+  input.addEventListener('keydown', e => {
+    if (e.key === 'Enter') { e.preventDefault(); finish(true); }
+    else if (e.key === 'Escape') { e.preventDefault(); finish(false); }
+  });
+  input.addEventListener('blur', () => finish(true));
+}
+
+function removeWord(idx) {
+  if (idx < 0) return;
+  const [entry] = sentence.splice(idx, 1);
+  if (entry.editor) entry.editor.remove();
+  entry.el.remove();
+  releaseBankTile(entry.word);
+  invalidateMuse();
+}
+
+function releaseBankTile(word) {
+  for (const t of bankEl.children) {
+    if (t.textContent === word && t.classList.contains('used')) {
+      t.classList.remove('used');
+      t.disabled = false;
+      return;
+    }
+  }
+}
+
+function markBankTile(word) {
+  for (const t of bankEl.children) {
+    if (t.textContent === word && !t.classList.contains('used')) {
+      t.classList.add('used');
+      t.disabled = true;
+      return;
+    }
+  }
+}
+
+document.getElementById('btn-undo').addEventListener('click', () => {
+  if (sentence.length) removeWord(sentence.length - 1);
+});
+document.getElementById('btn-clear').addEventListener('click', () => {
+  while (sentence.length) removeWord(sentence.length - 1);
+});
+
+document.getElementById('manual-form').addEventListener('submit', e => {
+  e.preventDefault();
+  const input = document.getElementById('manual-input');
+  const w = input.value.trim().toLowerCase().replace(/[^a-z'\-]/g, '');
+  if (!w) return;
+  placeWord(w);
+  input.value = '';
+  input.focus();
+});
+
+// ---------- 缪斯 · 大模型接口 ----------
+const sentenceText = () => sentence.map(s => s.word).join(' ');
+let lastStory = '';
+let museBusy = false;
+
+function renderMuseSentence() {
+  const el = document.getElementById('muse-sentence');
+  const strip = document.getElementById('share-strip');
+  if (!sentence.length) {
+    el.innerHTML = '<span class="placeholder">还没有句子 —— 先回拼贴台放几个词吧。</span>';
+    strip.classList.remove('show');
+    return;
+  }
+  el.innerHTML = '「 ' + escapeHtml(sentenceText()) + ' 」';
+  // 拼好句子就能分享；生成故事后按钮会改为分享故事。
+  document.getElementById('btn-share').textContent =
+    lastStory ? '分享这个故事 →' : '分享到诗集墙 →';
+  strip.classList.add('show');
+}
+
+function invalidateMuse() {
+  lastStory = '';
+  museOut.innerHTML = '<span class="placeholder">句子已更新 —— 再让缪斯读一读吧。</span>';
+  document.getElementById('share-strip').classList.remove('show');
+  if (currentPage === 'muse') renderMuseSentence();
+}
+
+async function evaluate(mode) {
+  if (!sentence.length) {
+    museOut.innerHTML = '<span class="placeholder">先拼一句吧 —— 哪怕只有一个词，缪斯也愿意读。</span>';
+    return;
+  }
+  if (museBusy) return;
+  museBusy = true;
+  lastStory = '';
+  document.getElementById('share-strip').classList.remove('show');
+  const label = {
+    critique: 'reading your line',
+    story: 'weaving a story',
+    learn: 'checking your grammar'
+  }[mode];
+  museOut.innerHTML = '<span class="thinking">' + label + '</span>';
+  try {
+    const data = await callMuse(mode);
+    if (mode === 'learn') {
+      renderLearn(data.content);
+    } else {
+      const text = String(data.content || '');
+      typewrite(text);
+      if (mode === 'story') lastStory = text;
+      document.getElementById('btn-share').textContent =
+        lastStory ? '分享这个故事 →' : '分享到诗集墙 →';
+    }
+    document.getElementById('share-strip').classList.add('show');
+  } catch (err) {
+    museOut.innerHTML =
+      '<div class="muse-error">缪斯暂时没有回应：' + escapeHtml(err.message) + '</div>' +
+      '<div class="muse-error-hint">请确认已在当前文件夹运行 <b>python server.py 8000</b>，并通过 http://localhost:8000 打开页面。</div>';
+  } finally {
+    museBusy = false;
+  }
+}
+
+async function callMuse(mode) {
+  const res = await fetch('/api/muse', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ sentence: sentenceText(), mode })
+  });
+  let data = null;
+  try { data = await res.json(); } catch (e) { /* 非 JSON 响应 */ }
+  if (!res.ok || !data || !data.ok) {
+    throw new Error((data && data.error) || ('接口返回 ' + res.status));
+  }
+  return data;
+}
+
+function typewrite(text) {
+  museOut.innerHTML = '<span class="poem-line">「 ' + escapeHtml(sentenceText()) + ' 」</span><span id="tw"></span><span class="caret"></span>';
+  const target = document.getElementById('tw');
+  let i = 0;
+  (function step() {
+    if (i <= text.length) {
+      target.textContent = text.slice(0, i++);
+      setTimeout(step, 26);
+    } else {
+      const c = museOut.querySelector('.caret');
+      if (c) c.remove();
+    }
+  })();
+}
+
+function renderLearn(content) {
+  if (!content || typeof content !== 'object') {
+    typewrite(String(content || '暂时没有得到讲评。'));
+    return;
+  }
+  if (content.raw) {
+    museOut.innerHTML =
+      '<span class="poem-line">「 ' + escapeHtml(sentenceText()) + ' 」</span>' +
+      '<div class="muse-raw">' + escapeHtml(String(content.raw)) + '</div>';
+    return;
+  }
+  const issues = Array.isArray(content.grammarIssues) ? content.grammarIssues : [];
+  const points = Array.isArray(content.knowledgePoints) ? content.knowledgePoints : [];
+
+  let html = '<div class="learn">';
+  html += '<p class="learn-head">「 ' + escapeHtml(sentenceText()) + ' 」</p>';
+  html += '<div class="learn-block"><h3>语法判断 <span>grammar</span></h3>';
+  if (issues.length) {
+    issues.forEach(it => {
+      html += '<div class="learn-item">' +
+        '<p class="learn-issue">' + escapeHtml(String(it.issue || '')) + '</p>' +
+        (it.fix ? '<p class="learn-fix">改：' + escapeHtml(String(it.fix)) + '</p>' : '') +
+        (it.why ? '<p class="learn-why">' + escapeHtml(String(it.why)) + '</p>' : '') +
+        '</div>';
+    });
+  } else {
+    html += '<p class="learn-why">暂时没有发现需要调整的地方。</p>';
+  }
+  html += '</div>';
+  html += '<div class="learn-block"><h3>知识点启发 <span>takeaways</span></h3>';
+  if (points.length) {
+    points.forEach(pt => {
+      html += '<div class="learn-item">' +
+        '<p class="learn-issue">' + escapeHtml(String(pt.title || '')) + '</p>' +
+        (pt.detail ? '<p class="learn-why">' + escapeHtml(String(pt.detail)) + '</p>' : '') +
+        (pt.example ? '<p class="learn-example">' + escapeHtml(String(pt.example)) + '</p>' : '') +
+        '</div>';
+    });
+  } else {
+    html += '<p class="learn-why">这次没有额外的知识点。</p>';
+  }
+  html += '</div>';
+  html += '</div>';
+  museOut.innerHTML = html;
+}
+
+document.getElementById('btn-critique').addEventListener('click', () => evaluate('critique'));
+document.getElementById('btn-story').addEventListener('click', () => evaluate('story'));
+document.getElementById('btn-learn').addEventListener('click', () => evaluate('learn'));
+
+// ---------- 社群诗集墙（本地模拟，正式版接入后端） ----------
+const SEED_POSTS = [
+  {
+    id: 'seed-1',
+    type: 'poem',
+    author: '雅',
+    time: '2 小时前',
+    content: 'he counts stars\nshe paints with light\nsoon\nwe lit the dark',
+    likes: 32, liked: false, ref: null
+  },
+  {
+    id: 'seed-2',
+    type: 'story',
+    author: '舟',
+    time: '昨天',
+    content: '后来我才知道，那颗星是他数了整整一个夏天才敢指给她看的。她没有说话，只把画笔蘸进夜色里——于是“soon”不再是等待，而是他们一起把黑暗点亮之前，最后的安静。',
+    likes: 18, liked: false,
+    ref: { author: '雅', excerpt: 'he counts stars / she paints with light / soon / we lit the dark' }
+  }
+];
+
+const store = {
+  load() {
+    try {
+      const raw = localStorage.getItem('wih-posts');
+      if (raw) return JSON.parse(raw);
+    } catch (e) { /* 隐私模式等场景下降级为内存态 */ }
+    return null;
+  },
+  save(posts) {
+    try { localStorage.setItem('wih-posts', JSON.stringify(posts)); } catch (e) {}
+  }
+};
+
+let posts = store.load() || SEED_POSTS;
+
+const feedEl = document.getElementById('feed');
+
+function renderFeed() {
+  feedEl.innerHTML = '';
+  posts.forEach(p => feedEl.appendChild(renderPost(p)));
+}
+
+function renderPost(p) {
+  const el = document.createElement('article');
+  el.className = 'post';
+
+  const isPoem = p.type === 'poem';
+  const body = isPoem
+    ? p.content.split('\n').map(l => `<span class="verse">${escapeHtml(l)}</span>`).join('')
+    : `<p>${escapeHtml(p.content)}</p>`;
+
+  el.innerHTML = `
+    <div class="post-meta">
+      <span class="post-tag ${p.type}">${isPoem ? '拼贴诗' : '故事续写'}</span>
+      <span class="post-author">@${escapeHtml(p.author)}</span>
+      <span class="post-time">${escapeHtml(p.time)}</span>
+    </div>
+    <div class="post-body">${body}</div>
+    ${p.ref ? `<p class="post-ref">续写自 @${escapeHtml(p.ref.author)} 的句子 <em>${escapeHtml(p.ref.excerpt)}</em></p>` : ''}
+    <div class="post-actions">
+      <button class="btn-like ${p.liked ? 'liked' : ''}">
+        <span class="heart">${p.liked ? '♥' : '♡'}</span>
+        <span class="like-n">${p.likes}</span> 盏灯
+      </button>
+      <button class="btn-continue">续写这个故事 →</button>
+    </div>`;
+
+  el.querySelector('.btn-like').addEventListener('click', () => {
+    p.liked = !p.liked;
+    p.likes += p.liked ? 1 : -1;
+    store.save(posts);
+    renderFeed();
+  });
+  el.querySelector('.btn-continue').addEventListener('click', () => {
+    openPublish({
+      type: 'story',
+      ref: { author: p.author, excerpt: excerptOf(p) }
+    });
+  });
+  return el;
+}
+
+function excerptOf(p) {
+  const first = p.content.split('\n')[0];
+  return first.length > 40 ? first.slice(0, 40) + '…' : first;
+}
+
+function escapeHtml(s) {
+  return s.replace(/[&<>"']/g, c => ({
+    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
+  }[c]));
+}
+
+// ---------- 发布 ----------
+let pubType = 'poem';
+let pubRef = null;
+
+const pubRefEl = document.getElementById('pub-ref');
+const pubContent = document.getElementById('pub-content');
+const pubLabel = document.getElementById('pub-content-label');
+
+function openPublish(opts = {}) {
+  pubRef = opts.ref || null;
+  setPubType(opts.type || 'poem');
+  if (pubRef) {
+    pubRefEl.innerHTML = `续写自 @${escapeHtml(pubRef.author)} 的句子 <em>${escapeHtml(pubRef.excerpt)}</em>`;
+    pubRefEl.classList.add('show');
+  } else {
+    pubRefEl.classList.remove('show');
+  }
+  pubContent.value = opts.content || '';
+  go('publish');
+  setTimeout(() => pubContent.focus(), 320);
+}
+
+function setPubType(t) {
+  pubType = t;
+  document.querySelectorAll('.pub-type').forEach(b =>
+    b.classList.toggle('active', b.dataset.type === t));
+  pubLabel.textContent = t === 'poem' ? '你的拼贴诗' : '你的续写故事';
+  pubContent.placeholder = t === 'poem'
+    ? 'he counts stars\nshe paints with light\nsoon\nwe lit the dark'
+    : '接着那句话，把故事往下写……';
+}
+document.querySelectorAll('.pub-type').forEach(b =>
+  b.addEventListener('click', () => setPubType(b.dataset.type)));
+
+document.getElementById('btn-new-post').addEventListener('click', () => openPublish());
+document.getElementById('btn-cancel-pub').addEventListener('click', () => go('community'));
+
+document.getElementById('btn-submit-pub').addEventListener('click', () => {
+  const content = pubContent.value.trim();
+  if (!content) {
+    pubContent.focus();
+    pubContent.placeholder = '先写点什么，再挂上墙吧——';
+    return;
+  }
+  const author = document.getElementById('pub-name').value.trim() || '匿名诗人';
+  posts.unshift({
+    id: 'p-' + Date.now(),
+    type: pubType,
+    author,
+    time: '刚刚',
+    content,
+    likes: 0, liked: false,
+    ref: pubRef
+  });
+  store.save(posts);
+  pubContent.value = '';
+  document.getElementById('pub-name').value = '';
+  renderFeed();
+  go('community');
+});
+
+// 缪斯间「分享到诗集墙」：生成过故事就分享故事，否则分享当前句子
+document.getElementById('btn-share').addEventListener('click', () => {
+  if (!sentence.length) return;
+  if (lastStory) openPublish({ type: 'story', content: lastStory });
+  else openPublish({ type: 'poem', content: sentenceText() });
+});
+
+// ---------- 初始化 ----------
+renderDevice();
+renderFeed();
+renderPage(pageFromHash());
+</script>
+
+<script type="module">
+import { WIHSerialBridge } from './serial-bridge.js';
+const button = document.getElementById('chip-toggle');
+const bridge = new WIHSerialBridge({
+  onWord(word) {
+    placeWord(word);
+    document.getElementById('hardware-word-status').textContent = `刚刚收到：${word}`;
+    // 从首页收到词块时自动进入拼贴台；其他页面只更新句子，不打断阅读。
+    if (currentPage === 'home') go('studio');
+  },
+  onStatus(status, state) {
+    deviceConnected = state.connected;
+    window.wihStatusText = status;
+    renderDevice();
+    button.textContent = state.running ? '断开连接' : '连接设备';
+    if (status.startsWith('连接中断') || status.startsWith('连接失败')) console.warn(status);
+  }
+});
+
+const importSentenceButton = document.getElementById('btn-import-sentence');
+const importStatus = document.getElementById('sentence-import-status');
+importSentenceButton.addEventListener('click', async () => {
+  importSentenceButton.disabled = true;
+  importStatus.textContent = '正在读取词块保存的整句…';
+  try {
+    const words = await bridge.requestSentence();
+    if (!words.length) {
+      importStatus.textContent = '这块词块还没有保存句子，请先在硬件上组成句子。';
+      return;
+    }
+    words.forEach(word => placeWord(word));
+    importStatus.textContent = `已放上 ${words.length} 个词：${words.join(' ')}`;
+  } catch (error) {
+    importStatus.textContent = error.message;
+  } finally {
+    importSentenceButton.disabled = false;
+  }
+});
+
+button.textContent = '连接设备';
+button.addEventListener('click', async () => {
+  button.disabled = true;
+  try {
+    if (bridge.running) await bridge.disconnect();
+    else await bridge.connect();
+  } catch (err) {
+    if (err.name !== 'NotFoundError') console.error('连接失败：', err);
+  }
+  finally { button.disabled = false; }
+});
+</script>
+</body>
+</html>
