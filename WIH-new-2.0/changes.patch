+  </section>
+
+  <section class="bank" aria-label="词库">
+    <div class="bank-head">
+      <p class="bank-label">词 库 · WORD BANK</p>
+      <button type="button" class="refresh-bank" id="btn-refresh-bank">↻ 换一组词块</button>
+    </div>
