+  </footer>
+</main>
+
+<!-- ================= 屏二·续 · 缪斯间 ================= -->
+<main class="muse-page screen is-hidden" id="screen-muse">
+  <button class="back-link" data-go="studio">← 返回拼贴台</button>
+  <header class="studio-head">
+    <h1>The Muse</h1>
+    <p>缪 斯 间 · 读 句 · 酿 故 事 · 学 语 言</p>
+  </header>
+
+  <section class="muse" aria-label="缪斯评价窗">
